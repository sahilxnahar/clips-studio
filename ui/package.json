{
  "name": "clips-studio",
  "version": "2.1.0",
  "description": "Local-first AI clipping studio (desktop app)",
  "author": "ColinGPT9",
  "homepage": "https://github.com/ColinGPT9/clips-studio",
  "license": "AGPL-3.0-or-later",
  "main": "./out/main/index.js",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.cjs",

{
	"name": "clips-kitty-web",
	"version": "0.1.0",
	"private": true,
	"description": "Browser-only free tier for Clips Kitty. Runs on the visitor's own OpenRouter account; no server, no inference cost.",
	"scripts": {
		"postinstall": "node scripts/copy-ffmpeg-core.mjs",
		"dev": "next dev --turbopack",
		"prebuild": "node scripts/copy-ffmpeg-core.mjs",
		"build": "next build",
		"start": "next start",
		"lint": "biome lint",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@ffmpeg/ffmpeg": "^0.12.15",
		"next": "16.4.6",
		"react": "19.3.1",
		"react-dom": "19.3.1"
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.9",
		"@ffmpeg/core": "^0.12.10",
		"@tailwindcss/postcss": "^4.3.5",
		"@types/node": "^26.6.11",
		"@types/react": "19.3.3",
		"@types/react-dom": "19.3.0",
		"tailwindcss": "^4.3.5",
		"typescript": "^7.0.2"
	}
}
